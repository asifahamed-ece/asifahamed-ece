# Environment variables for the self-hosted github-readme-stats deployment.
# Set these in Vercel: Project -> Settings -> Environment Variables.
# Do NOT commit real tokens.

# GitHub Personal Access Token (scopes: repo, read:user).
# Used to include private contributions and lift GraphQL rate limits.
PAT_1=

# Optional overrides (see upstream repo docs):
# CACHE_SECONDS=14400
# EXCLUDE_REPO=
# WHITELIST=
# GIST_WHITELIST=