# Environment variables for the self-hosted github-readme-streak-stats deployment.
# Set these in Vercel: Project -> Settings -> Environment Variables.
# Do NOT commit real tokens.

# GitHub Personal Access Token. Upstream requires NO scopes for this service --
# the token exists only to authenticate the GraphQL contributions query and lift
# the rate limit (60/hr unauthenticated vs 5000/hr authenticated).
# Create one: https://github.com/settings/tokens/new?description=GitHub%20Readme%20Streak%20Stats
# Required: api/index.php renders an error card instead of a streak when unset.
TOKEN=

# Optional: only these usernames' streaks are served (comma-separated).
# WHITELIST=asifahamed-ece

# Optional overrides -- see the Caching section of DEPLOY.md before touching these.
# DISABLE_CACHE=true
