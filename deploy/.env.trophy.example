# Environment variables for the self-hosted github-profile-trophy deployment.
# Set these in Vercel: Project -> Settings -> Environment Variables.
# Do NOT commit real tokens. The service works with no token (lower rate limit);
# for reliable rendering provide one or two GitHub PATs below.

# GitHub Personal Access Token(s) (scopes: repo, read:user). Shared round-robin.
GITHUB_TOKEN1=
GITHUB_TOKEN2=

# Optional Redis cache (leave empty to disable caching):
# ENABLE_REDIS=false
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=