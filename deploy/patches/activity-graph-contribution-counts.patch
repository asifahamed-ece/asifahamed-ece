+import moment from 'moment';
 import { createGraph } from './createChart';
 import { graphSvg } from './svgs';
 import { Colors, ContributionDay } from './interfaces/interface';
 
+/**
+ * Inject a <title> tooltip into every .ct-point element of a chartist SVG so
+ * that hovering a point shows "<date>: <n> contributions". Chartist emits the
+ * points in the same order as the days array.
+ *
+ * The date has to come from `isoDate`, not `date`: fetcher.ts reduces `date`
+ * to the bare day-of-month for the axis labels, and moment("27") is not a date.
+ *
+ * NOTE: tooltips only work when the SVG is opened directly in a browser;
+ * GitHub renders README images in a non-interactive <img> context.
+ */
+function injectPointTooltips(svg: string, days: ContributionDay[]): string {
+    let index = 0;
+    return svg.replace(
+        /<(line|circle)\b([^>]*class="ct-point"[^>]*?)(\/?)>/g,
+        (match, tag: string, attrs: string, selfClose: string) => {
+            const day = days[index++];
+            if (!day) return match;
+            const when = day.isoDate
+                ? moment(day.isoDate, moment.ISO_8601).format('MMM D')
+                : `day ${day.date}`;
+            const label = `${when}: ${day.contributionCount} contribution${
+                day.contributionCount === 1 ? '' : 's'
+            }`;
+            // chartist emits paired tags (<line ...> ... </line>) — keep the
+            // opening tag's ">" and do NOT add a close (one already follows).
+            // For self-closing forms, emit a full closing tag instead.
+            return selfClose
+                ? `<${tag}${attrs}><title>${label}</title></${tag}>`
+                : `<${tag}${attrs}><title>${label}</title>`;
+        },
+    );
+}
